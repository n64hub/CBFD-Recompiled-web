+    long long WorkloadQueue::logTime() {
+        const auto sinceEpoch = std::chrono::system_clock::now().time_since_epoch();
+        return (long long)(std::chrono::duration_cast<std::chrono::milliseconds>(sinceEpoch).count());
+    }
